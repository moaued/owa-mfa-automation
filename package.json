{
  "name": "owa-mfa-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright and Cucumber automation for the OWA MFA flow",
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:smoke": "cucumber-js --config cucumber.js --tags @smoke",
    "test:regression": "cucumber-js --config cucumber.js --tags @regression",
    "test:dry-run": "cucumber-js --config cucumber.js --dry-run",
    "test:unit": "node --test tests/test-data.test.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.55.0"
  }
}
